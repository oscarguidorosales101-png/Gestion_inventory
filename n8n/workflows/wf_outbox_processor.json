            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrutar por Tipo de Evento": {
      "main": [
        [
          {
            "node": "Transformar y Asignar Idempotency-Key",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Transformar y Asignar Idempotency-Key",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Transformar y Asignar Idempotency-Key",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Transformar y Asignar Idempotency-Key",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Transformar y Asignar Idempotency-Key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transformar y Asignar Idempotency-Key": {
      "main": [
        [
          {
            "node": "Completar Evento Outbox (POST)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
