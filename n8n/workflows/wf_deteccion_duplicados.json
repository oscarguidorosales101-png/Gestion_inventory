{
  "name": "Gestion_Inventory - Auditoria y Deteccion de Duplicados",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "node-schedule-dup",
      "name": "Schedule Trigger (Cada 30 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3001/api/integracion/auditoria/duplicados-pendientes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Integration-Key",
              "value": "9dd014ab00baa9bc65010e45e97813bf73645d329d988939faaf01c1d73a949e"
            }
          ]
        }
      },
      "id": "node-consultar-duplicados",
      "name": "Consultar Duplicados Pendientes (GET)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.data?.total_duplicados || $json.data?.total || 0 }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "node-if-hay-duplicados",
      "name": "Hay Casos Pendientes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const pendientes = $input.item.json.data?.items || $input.item.json.data?.ordenes || [];\nreturn {\n  timestamp: new Date().toISOString(),\n  total_pendientes: pendientes.length,\n  casos: pendientes.map(o => ({\n    id: o.id,\n    numero_orden: o.numero_orden,\n    proveedor: o.proveedor_nombre,\n    total_crc: o.total_crc,\n    orden_similar_id: o.orden_similar_id\n  })),\n  mensaje: `Atencion: Se encontraron ${pendientes.length} orden(es) de compra con sospecha de duplicado pendiente de revision.`\n};"
      },
      "id": "node-formato-alerta-dup",
      "name": "Consolidar Informe Duplicados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        240
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (Cada 30 min)": {
      "main": [
        [
          {
            "node": "Consultar Duplicados Pendientes (GET)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar Duplicados Pendientes (GET)": {
      "main": [
        [
          {
            "node": "Hay Casos Pendientes?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hay Casos Pendientes?": {
      "main": [
        [
          {
            "node": "Consolidar Informe Duplicados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
