        "jsCode": "const res = $input.item.json;\nconst totalEvaluados = res.data?.materiales_evaluados || 0;\nconst activas = res.data?.alertas_activas_actuales || 0;\nreturn {\n  timestamp: new Date().toISOString(),\n  totalEvaluados,\n  activas,\n  estado_ejecucion: 'SUCCESS',\n  resumen: `Sincronizacion completada: ${totalEvaluados} materiales evaluados, ${activas} alertas activas.`\n};"
      },
