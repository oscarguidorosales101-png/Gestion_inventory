{
  "name": "gestion-inventory-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Gestion_inventory (Express + MySQL 8.0)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup:env": "node scripts/setup-local-env.mjs",
    "setup:testdb": "node scripts/setup-test-db.mjs",
    "usuarios:inicializar": "node scripts/inicializar-usuario.mjs",
    "db:verificar": "node scripts/verificar-conexion.mjs",
    "test": "node --import ./tests/helpers/setTestEnv.js --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --import ./tests/helpers/setTestEnv.js --test tests/unit/*.test.js",
    "test:integration": "node --import ./tests/helpers/setTestEnv.js --test --test-concurrency=1 tests/integration/*.test.js"
  },
  "dependencies": {
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0",
    "zod": "^3.24.2"
  }
}

