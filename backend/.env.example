# Configuracion de Entorno — Gestion_inventory Backend
# NOTA: Este archivo es una plantilla. No incluir credenciales reales aqui.
# Copiar a backend/.env y configurar los valores locales.

# Servidor HTTP
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL (Usuario de aplicacion gestion_inventory_app con privilegios minimos: SELECT, INSERT, UPDATE, DELETE)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_inventory
DB_USER=gestion_inventory_app
DB_PASSWORD=

# Base de datos MySQL para pruebas automatizadas (aislada)
TEST_DB_NAME=gestion_inventory_test

# Seguridad de Tokens y Sesion (Hexadecimal seguro de 64 caracteres)
JWT_SECRET=
SESSION_EXPIRATION_HOURS=8

# Clave de integracion de servicio para n8n (cabecera HTTP X-Integration-Key)
N8N_INTEGRATION_API_KEY=

# URL base interna de Express para que n8n invoque endpoints de integracion
BACKEND_INTERNAL_URL=http://localhost:3001

# Google Gemini API (Asesor Inteligente de Abastecimiento y Riesgos)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
